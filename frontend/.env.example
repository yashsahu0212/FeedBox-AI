# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# n8n AI Workflow Webhook Integration (Optional)
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/classify-complaint

# Direct LLM Provider API Integration (Optional: openai, groq, ollama, gemini)
VITE_LLM_PROVIDER=openai
VITE_LLM_API_KEY=your-llm-api-key-here
VITE_LLM_MODEL=gpt-4o-mini
VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
