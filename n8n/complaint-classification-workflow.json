{
  "name": "CampusAI Complaint Classification & Department Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "classify-complaint",
        "options": {}
      },
      "name": "Webhook - Submit Complaint",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "text",
              "value": "={{ $json.body.text }}"
            },
            {
              "name": "complaint_id",
              "value": "={{ $json.body.complaint_id }}"
            },
            {
              "name": "user_id",
              "value": "={{ $json.body.user_id }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Validate & Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "systemMessage": "You are CampusAI Complaint Classification Engine. Read student complaints (English, Hinglish) and return strictly JSON containing: intent_type, category, subcategory, department (CTS, Hostel Committee, Security, Academic, Accounts, Mess, Transport, Administration), priority (low, medium, high, urgent), issue_summary, requested_action, location (hostel_block, floor, wing, room, additional_location), confidence (0.0 to 1.0), and multiple_issues flag."
        }
      },
      "name": "AI LLM Classification Node",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.confidence }}",
              "operation": "largerEqual",
              "value2": 0.70
            }
          ]
        }
      },
      "name": "Confidence Check (>= 0.70)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [740, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.multiple_issues }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Multi-Issue Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 240]
    },
    {
      "parameters": {
        "fieldToSplitOut": "issues",
        "options": {}
      },
      "name": "Split Multi-Issues",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [1180, 160]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.department }}",
        "rules": {
          "rules": [
            { "value2": "CTS", "output": 0 },
            { "value2": "Hostel Committee", "output": 1 },
            { "value2": "Security", "output": 2 },
            { "value2": "Academic", "output": 3 },
            { "value2": "Accounts", "output": 4 },
            { "value2": "Mess", "output": 5 },
            { "value2": "Transport", "output": 6 }
          ]
        },
        "fallbackOutput": 7
      },
      "name": "Department Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.priority }}",
              "value2": "urgent"
            }
          ]
        }
      },
      "name": "Urgent Priority Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1620, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1840, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "routing_status",
              "value": "manual_review"
            },
            {
              "name": "department",
              "value": "manual_review"
            }
          ]
        },
        "options": {}
      },
      "name": "Route to Manual Review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [960, 420]
    }
  ],
  "connections": {
    "Webhook - Submit Complaint": {
      "main": [[{ "node": "Validate & Normalize Input", "type": "main", "index": 0 }]]
    },
    "Validate & Normalize Input": {
      "main": [[{ "node": "AI LLM Classification Node", "type": "main", "index": 0 }]]
    },
    "AI LLM Classification Node": {
      "main": [[{ "node": "Confidence Check (>= 0.70)", "type": "main", "index": 0 }]]
    },
    "Confidence Check (>= 0.70)": {
      "main": [
        [{ "node": "Multi-Issue Check", "type": "main", "index": 0 }],
        [{ "node": "Route to Manual Review", "type": "main", "index": 0 }]
      ]
    },
    "Multi-Issue Check": {
      "main": [
        [{ "node": "Split Multi-Issues", "type": "main", "index": 0 }],
        [{ "node": "Department Router", "type": "main", "index": 0 }]
      ]
    },
    "Split Multi-Issues": {
      "main": [[{ "node": "Department Router", "type": "main", "index": 0 }]]
    },
    "Department Router": {
      "main": [
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }],
        [{ "node": "Urgent Priority Check", "type": "main", "index": 0 }]
      ]
    },
    "Route to Manual Review": {
      "main": [[{ "node": "Webhook Response", "type": "main", "index": 0 }]]
    },
    "Urgent Priority Check": {
      "main": [
        [{ "node": "Webhook Response", "type": "main", "index": 0 }],
        [{ "node": "Webhook Response", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {}
}
